# Brindoleta — dados configurados somente na hospedagem (Vercel).
# Nunca preencha valores reais em commits públicos.
BRINDOLETA_PIX_KEY=
BRINDOLETA_PIX_RECEIVER=

# Link de cobrança Pix. Se não informado, usa a cobrança padrão de R$ 47 do Nubank.
BRINDOLETA_PIX_PAYMENT_URL=

# Opcional: URL HTTPS de um QR Pix fornecido pelo banco.
BRINDOLETA_PIX_QR_IMAGE_URL=

# Opcional: segredo exclusivo para anonimizar a rede dos giros. Se vazio,
# o servidor usa a própria service role como chave HMAC e nunca salva o IP.
BRINDOLETA_FINGERPRINT_SECRET=

# Meta Pixel + Conversions API. O token fica somente no servidor.
NEXT_PUBLIC_META_PIXEL_ID=415652621143755
META_CONVERSIONS_ACCESS_TOKEN=
META_CONVERSIONS_API_VERSION=v25.0
# Opcional durante a validacao no Gerenciador de Eventos da Meta.
META_TEST_EVENT_CODE=
