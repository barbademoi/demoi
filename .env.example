# Brindoleta — dados configurados somente na hospedagem (Vercel).
# Nunca preencha valores reais em commits públicos.
BRINDOLETA_PIX_KEY=
BRINDOLETA_PIX_RECEIVER=

# Link de cobrança Pix. Se não informado, usa a cobrança padrão de R$ 47 do Nubank.
BRINDOLETA_PIX_PAYMENT_URL=

# Opcional: URL HTTPS de um QR Pix fornecido pelo banco.
BRINDOLETA_PIX_QR_IMAGE_URL=
